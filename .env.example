# Copy to .env and fill in what you have. Untouched, this file runs a whole
# interview on the `fake` LLM and STT providers -- no key required.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://interviewer:interviewer@localhost:5433/interviewer
REDIS_URL=redis://localhost:6380/0

# --- Auth: one admin account type, one passkey door -------------------
AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
REGISTRATION_OPEN=false
PUBLIC_BASE_URL=http://localhost:8000
INVITE_TTL_HOURS=168
CANDIDATE_TOKEN_TTL_MINUTES=120
PASSKEY_MAX_ATTEMPTS=5
PASSKEY_LOCKOUT_MINUTES=15

# --- LLM ----------------------------------------------------------------
LLM_PROVIDER=fake
LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
LLM__OPENROUTER__API_KEY=
LLM__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
LLM__OPENAI_COMPAT__API_KEY=
LLM__OPENAI_COMPAT__BASE_URL=

# --- Speech: audio in, text out ------------------------------------------
STT_PROVIDER=fake
STT_MODEL=
STT_LANGUAGE=
STT__OPENAI_COMPAT__API_KEY=
STT__OPENAI_COMPAT__BASE_URL=

REPLY_MODE=text
TTS_PROVIDER=none
TTS_MODEL=
TTS_VOICE=
TTS__OPENAI_COMPAT__API_KEY=
TTS__OPENAI_COMPAT__BASE_URL=

# --- Infrastructure adapters ----------------------------------------------
STORAGE_PROVIDER=local_fs
STORAGE__LOCAL_FS__ROOT=./var/blobs
STORAGE__GCS__BUCKET=
STORAGE__GCS__CREDENTIALS_JSON=
STORAGE__S3__BUCKET=
STORAGE__S3__REGION=
STORAGE__S3__ACCESS_KEY_ID=
STORAGE__S3__SECRET_ACCESS_KEY=
STORAGE__S3__ENDPOINT_URL=

WORKFLOW_PROVIDER=redis
WORKFLOW_VISIBILITY_TIMEOUT_SECONDS=120
WORKFLOW_MAX_ATTEMPTS=3

# --- Upload guards: validated at the boundary, nowhere else ---------------
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_SECONDS=300
UPLOAD_ALLOWED_MIME=audio/webm,audio/ogg,audio/wav,audio/mpeg
SESSION_MAX_TURNS=40
